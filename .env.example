# Exhaustive on purpose: boot parses this shape with Zod and fails fast on anything
# missing, so an undocumented variable is a startup crash rather than a runtime surprise.

NODE_ENV=development
PORT=8787

# Postgres. Ports match docker/compose.dev.yml, which deliberately does not use 5432/6379
# so it cannot collide with another project's stack on the same machine.
DATABASE_URL=postgres://proxlane:proxlane@localhost:5442/proxlane

# Valkey. No persistence by design — everything in here is reconstructible.
VALKEY_URL=redis://localhost:6389

# Concurrency ceiling. The boot refine asserts maxInflight * bodyCapMb * 2.5 < availableMb,
# reading the cgroup v2 limit and failing fast when it is absent AND this is unset. It does
# not fall back to os.totalmem(), which reports the host's memory inside a limited
# container and would reopen the hole the check exists to close.
MAX_INFLIGHT=32
BODY_CAP_MB=10
# PROXLANE_MEMORY_LIMIT_MB=1024   # required when no cgroup limit is readable

# --- self-host -----------------------------------------------------------------------
# Authenticates callers TO the gateway. The server REFUSES TO BOOT without it: a gateway
# started open is a proxy funded by whoever deployed it, and that is not recoverable.
#   openssl rand -hex 32
PROXLANE_API_KEY=

# Per-request global deadline, and the response body cap. Both have defaults; both are
# documented here because the gateway reads them and a variable nobody can find is a
# variable nobody sets correctly.
# PROXLANE_DEADLINE_MS=90000
# PROXLANE_BODY_CAP_MB=10

# Provider health. OFF by default. Set to `on` to have the gateway keep a running opinion of
# each provider and route around one that is failing.
#
# Off because the detector's calibration assumes independent failures, and providers have
# regimes — a bad hour, a struggling upstream. A two-regime provider with the same MEAN
# failure rate spends over 90% of its time demoted in simulation, against 0.8% for the iid
# stream the thresholds were tuned on. Turn it on deliberately, and watch
# GET /health/providers. Cooldowns are separate and stay on: they act on facts, not inference.
# Health is stored IN THIS PROCESS, so run one gateway. PROXLANE_REPLICAS>1 refuses to boot
# rather than let two replicas demote independently — see apps/gateway/src/health-store.ts.
# PROXLANE_HEALTH=on
# PROXLANE_REPLICAS=1

# Cooldowns. ON by default: a provider that refused this domain ninety seconds ago is
# skipped rather than paid to refuse again. Also in-process, so the replica rule above
# applies to these too.
# PROXLANE_COOLDOWNS=off

# Shared state, and the only way to run more than one gateway. Unset, health and cooldowns
# live in the gateway process. Both fail OPEN if Valkey is unreachable, so the cost of it
# being down is worse routing rather than refused requests.
# PROXLANE_VALKEY_URL=redis://valkey:6379

# Namespaces this deployment's account-scoped cooldowns (`cd:acct:{org}:...`). Only matters
# when more than one deployment shares a Valkey: without it both write `self` and one
# deployment's expired provider key cools that provider for the other.
#
# Provider HEALTH keys are not namespaced — they are global by design — so give separate
# deployments separate Valkey databases (`redis://host:6379/1`) rather than sharing one.
# PROXLANE_ORG_ID=self

# BYOK. Set the providers you actually pay for; the rest are simply left out of the chain.
# At least one is required. `proxlane providers` lists the exact variable per provider.
SCRAPERAPI_KEY=
SCRAPINGBEE_KEY=
SCRAPFLY_KEY=
