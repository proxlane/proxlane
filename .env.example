# Exhaustive on purpose: boot parses this shape with Zod and fails fast on anything
# missing, so an undocumented variable is a startup crash rather than a runtime surprise.

NODE_ENV=development
PORT=8787

# Postgres. Ports match docker/compose.dev.yml, which deliberately does not use 5432/6379
# so it cannot collide with another project's stack on the same machine.
DATABASE_URL=postgres://proxlane:proxlane@localhost:5442/proxlane

# Valkey. No persistence by design — everything in here is reconstructible.
VALKEY_URL=redis://localhost:6389

# Concurrency ceiling. The boot refine asserts maxInflight * bodyCapMb * 2.5 < availableMb,
# reading the cgroup v2 limit and failing fast when it is absent AND this is unset. It does
# not fall back to os.totalmem(), which reports the host's memory inside a limited
# container and would reopen the hole the check exists to close.
MAX_INFLIGHT=32
BODY_CAP_MB=10
# PROXLANE_MEMORY_LIMIT_MB=1024   # required when no cgroup limit is readable

# --- self-host -----------------------------------------------------------------------
# Authenticates callers TO the gateway. The server REFUSES TO BOOT without it: a gateway
# started open is a proxy funded by whoever deployed it, and that is not recoverable.
#   openssl rand -hex 32
PROXLANE_API_KEY=

# Provider health. ON by default: the gateway keeps a running opinion of each provider and
# routes around one that is failing. `off` restores the plain static chain.
# Health is stored IN THIS PROCESS, so run one gateway. PROXLANE_REPLICAS>1 refuses to boot
# rather than let two replicas demote independently — see apps/gateway/src/health-store.ts.
# PROXLANE_HEALTH=off
# PROXLANE_REPLICAS=1

# BYOK. Set the providers you actually pay for; the rest are simply left out of the chain.
# At least one is required. `proxlane providers` lists the exact variable per provider.
SCRAPERAPI_KEY=
SCRAPINGBEE_KEY=
SCRAPFLY_KEY=
