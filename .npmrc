# Node 24 is a hard pin: the gateway needs undici's per-origin pools and explicit
# headersTimeout/bodyTimeout. Fail loudly rather than silently building on 22.
engine-strict=true

# NOT strict: it turns every upstream peer-range lag into a blocked install. Genuine
# strictness belongs in reviewed pnpm.peerDependencyRules entries, not a blanket flag.
strict-peer-dependencies=false

# Exact versions in package.json. The catalog carries the range; packages carry `catalog:`.
save-prefix=''
