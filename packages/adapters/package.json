{
	"name": "@proxlane/adapters",
	"version": "0.6.0",
	"description": "Provider adapters, capability registry and cost tables for Proxlane. Apache-2.0 \u2014 write one for your provider.",
	"keywords": [
		"web-scraping",
		"scraping-api",
		"adapter",
		"scraperapi",
		"scrapingbee",
		"scrapfly",
		"bright-data",
		"proxy",
		"cost"
	],
	"homepage": "https://proxlane.dev",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/proxlane/proxlane.git",
		"directory": "packages/adapters"
	},
	"bugs": {
		"url": "https://github.com/proxlane/proxlane/issues"
	},
	"type": "module",
	"license": "Apache-2.0",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsdown src/index.ts --format esm --dts && tsdown src/dev-registry.ts --format esm --out-dir dev-dist && tsdown conformance/index.ts --format esm --out-dir conformance-dist",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"clean": "rm -rf dist dev-dist conformance-dist"
	},
	"devDependencies": {
		"@proxlane/tsconfig": "workspace:*",
		"@types/node": "catalog:",
		"tsdown": "catalog:",
		"typescript": "catalog:"
	},
	"dependencies": {
		"@proxlane/shared": "workspace:*",
		"zod": "catalog:"
	}
}
