{
	"name": "@proxlane/shared",
	"version": "0.10.0",
	"description": "The Proxlane outcome taxonomy, request shape and SSRF edge guard, shared by the gateway and every adapter.",
	"keywords": [
		"web-scraping",
		"scraping-api",
		"ssrf",
		"outcome",
		"taxonomy",
		"proxy"
	],
	"homepage": "https://proxlane.dev",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/proxlane/proxlane.git",
		"directory": "packages/shared"
	},
	"bugs": {
		"url": "https://github.com/proxlane/proxlane/issues"
	},
	"type": "module",
	"license": "Apache-2.0",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		},
		"./outcome": {
			"types": "./dist/outcome.d.mts",
			"default": "./dist/outcome.mjs"
		},
		"./error-body": {
			"types": "./dist/error-body.d.mts",
			"default": "./dist/error-body.mjs"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsdown src/index.ts src/outcome.ts src/error-body.ts --format esm --dts",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"clean": "rm -rf dist"
	},
	"devDependencies": {
		"@proxlane/tsconfig": "workspace:*",
		"@types/node": "catalog:",
		"tsdown": "catalog:",
		"typescript": "catalog:"
	}
}
