{
	"name": "@proxlane/sdk",
	"version": "0.0.2",
	"description": "An MCP server that gives an AI agent a web-fetch tool through your self-hosted Proxlane gateway: failover across scraping APIs, and a failed fetch is reported as a failure, never handed over as content.",
	"keywords": [
		"mcp",
		"model-context-protocol",
		"mcp-server",
		"ai-agents",
		"web-scraping",
		"scraping-api",
		"failover",
		"proxlane"
	],
	"homepage": "https://proxlane.dev",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/proxlane/proxlane.git",
		"directory": "packages/sdk"
	},
	"bugs": {
		"url": "https://github.com/proxlane/proxlane/issues"
	},
	"type": "module",
	"license": "Apache-2.0",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsdown src/index.ts --format esm --dts",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"clean": "rm -rf dist"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@proxlane/tsconfig": "workspace:*",
		"@types/node": "catalog:",
		"tsdown": "catalog:",
		"typescript": "catalog:"
	}
}
