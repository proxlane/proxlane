{
	"name": "@proxlane/detect",
	"version": "0.1.0",
	"type": "module",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/proxlane/proxlane.git",
		"directory": "packages/detect"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsdown src/index.ts --format esm --dts",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"clean": "rm -rf dist"
	},
	"devDependencies": {
		"@proxlane/tsconfig": "workspace:*",
		"@types/node": "catalog:",
		"tsdown": "catalog:",
		"typescript": "catalog:"
	}
}
