{
	"name": "@proxlane/detect",
	"version": "0.3.1",
	"description": "Soft-block detection for scraped responses: the HTTP 200 that is really a captcha or a challenge page.",
	"keywords": [
		"web-scraping",
		"bot-detection",
		"captcha",
		"cloudflare",
		"datadome",
		"block-page",
		"scraping-api"
	],
	"homepage": "https://proxlane.dev",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/proxlane/proxlane.git",
		"directory": "packages/detect"
	},
	"bugs": {
		"url": "https://github.com/proxlane/proxlane/issues"
	},
	"type": "module",
	"license": "Apache-2.0",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsdown src/index.ts --format esm --dts",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"clean": "rm -rf dist"
	},
	"devDependencies": {
		"@proxlane/tsconfig": "workspace:*",
		"@types/node": "catalog:",
		"tsdown": "catalog:",
		"typescript": "catalog:"
	}
}
