{
	"name": "proxlane",
	"version": "0.4.6",
	"description": "Proxlane CLI — doctor, the self-host support surface",
	"keywords": [
		"web-scraping",
		"scraping-api",
		"proxy",
		"failover",
		"scraperapi",
		"scrapingbee",
		"scrapfly",
		"bright-data",
		"cli",
		"self-hosted"
	],
	"homepage": "https://proxlane.dev",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/proxlane/proxlane.git",
		"directory": "packages/cli"
	},
	"bugs": {
		"url": "https://github.com/proxlane/proxlane/issues"
	},
	"type": "module",
	"license": "AGPL-3.0-only",
	"bin": {
		"proxlane": "./dist/bin.mjs"
	},
	"files": [
		"dist",
		"skills"
	],
	"scripts": {
		"build": "tsdown src/bin.ts --format esm",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"clean": "rm -rf dist"
	},
	"devDependencies": {
		"@proxlane/tsconfig": "workspace:*",
		"@types/node": "catalog:",
		"tsdown": "catalog:",
		"typescript": "catalog:"
	},
	"dependencies": {
		"@proxlane/adapters": "workspace:*",
		"@proxlane/shared": "workspace:*"
	}
}
