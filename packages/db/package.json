{
	"name": "@proxlane/db",
	"version": "0.1.1",
	"type": "module",
	"license": "AGPL-3.0-only",
	"private": true,
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsdown src/index.ts --format esm --dts",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"clean": "rm -rf dist",
		"test": "vitest run",
		"codegen:auth": "node scripts/generate-auth-schema.ts",
		"db:generate": "drizzle-kit generate"
	},
	"devDependencies": {
		"@proxlane/containers": "workspace:*",
		"@proxlane/tsconfig": "workspace:*",
		"@types/node": "catalog:",
		"@types/pg": "catalog:",
		"drizzle-kit": "catalog:",
		"testcontainers": "catalog:",
		"tsdown": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"dependencies": {
		"better-auth": "catalog:",
		"drizzle-orm": "catalog:",
		"pg": "catalog:",
		"zod": "catalog:"
	}
}
