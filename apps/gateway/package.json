{
	"name": "@proxlane/gateway",
	"version": "0.14.3",
	"type": "module",
	"private": true,
	"license": "AGPL-3.0-only",
	"scripts": {
		"dev": "tsdown src/index.ts src/app.ts --format esm --watch src --on-success \"node dist/index.mjs\"",
		"build": "tsdown src/index.ts src/app.ts --format esm --dts",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"clean": "rm -rf dist"
	},
	"dependencies": {
		"@hono/node-server": "catalog:",
		"@proxlane/adapters": "workspace:*",
		"@proxlane/detect": "workspace:*",
		"@proxlane/shared": "workspace:*",
		"hono": "catalog:",
		"ioredis": "catalog:"
	},
	"devDependencies": {
		"@proxlane/tsconfig": "workspace:*",
		"@types/node": "catalog:",
		"tsdown": "catalog:",
		"typescript": "catalog:",
		"@proxlane/vitest-config": "workspace:*"
	},
	"exports": {
		".": "./dist/index.mjs",
		"./app": {
			"types": "./dist/app.d.mts",
			"default": "./dist/app.mjs"
		}
	}
}
