{
	"name": "proxlane-monorepo",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.34.5+sha512.a4ee05f2f73658255bd6a89859c065a45c28a57daefae2c893a168ee2b73168c37b91e83e57ea67654ad03f03031746430e8bce38e362e042605fb8abc80192e",
	"engines": {
		"node": ">=24.11.0 <25"
	},
	"scripts": {
		"bootstrap": "node scripts/bootstrap.ts",
		"build": "turbo run build",
		"changeset": "changeset",
		"check": "node scripts/check.ts",
		"conformance": "turbo run build --filter=@proxlane/adapters && node scripts/conformance.ts",
		"content:lint": "node scripts/not-implemented.ts content:lint",
		"dev": "turbo run dev --parallel",
		"docs:check": "node scripts/not-implemented.ts docs:check",
		"k6:soak": "node scripts/not-implemented.ts k6:soak",
		"lighthouse:assert": "node scripts/lighthouse-assert.ts --config=tooling/lighthouse/lighthouserc.json",
		"lint": "biome ci .",
		"new-adapter": "node scripts/new-adapter.ts",
		"pages:check": "node scripts/not-implemented.ts pages:check",
		"record": "node scripts/record.ts",
		"release:dry": "node scripts/release-dry.ts",
		"repo:check": "node scripts/repo-check.ts",
		"selfhost:smoke": "node scripts/selfhost-smoke.ts",
		"test:contract": "vitest run --project contract",
		"test:e2e": "vitest run --project e2e",
		"test:live": "vitest run --project live",
		"test:ssrf": "vitest run --project ssrf",
		"test:unit": "vitest run --project unit",
		"tokens:check": "node scripts/tokens-check.ts",
		"typecheck": "turbo run typecheck"
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"@changesets/cli": "catalog:",
		"@lhci/cli": "catalog:",
		"@types/node": "catalog:",
		"turbo": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"dependencies": {
		"proxlane": "workspace:*"
	}
}
