#!/bin/sh
# The same set CI runs, before it can reach a branch anyone else sees.
#
# This exists because a red lint reached main once: nothing on a free private repo requires
# a check, so "green" meant "green when someone last remembered to look". A ruleset replaces
# this the day the repo goes public; until then it is the only thing standing there.
#
# Skip deliberately with --no-verify when you know what you are doing.
set -e

# GUI git clients start with a minimal PATH and will not find a version-managed pnpm.
# Say so, rather than failing with "pnpm: not found" and looking like a broken repo.
if ! command -v pnpm >/dev/null 2>&1; then
	echo "pre-push: pnpm not on PATH — skipping the contract."
	echo "  This usually means a GUI git client with a minimal environment."
	echo "  Push from a terminal, or run 'pnpm build typecheck lint repo:check test:unit' first."
	exit 0
fi

LOG=$(mktemp -t proxlane-prepush)
trap 'rm -f "$LOG"' EXIT

echo "pre-push: running the contract (skip with --no-verify)"
for cmd in build typecheck lint repo:check test:unit; do
	printf '  %-12s ' "$cmd"
	if pnpm "$cmd" >"$LOG" 2>&1; then
		echo "ok"
	else
		echo "FAILED"
		echo ""
		tail -25 "$LOG"
		echo ""
		echo "  pnpm $cmd failed. Push aborted."
		exit 1
	fi
done

# The changeset gate, which CI enforces and this hook did not — so the only way to learn you
# had missed one was a red PR, by which point the PR body usually already claimed otherwise.
# That happened. It is cheap to check here and it is the difference between a mistake you fix
# before anyone sees it and one you fix in public.
#
# Exit 2 means "nothing to judge" — no commits differ from origin/main, which is normal when
# pushing main itself. Only exit 1, a genuine missing changeset, blocks the push.
printf '  %-12s ' "changeset"
if git rev-parse --verify --quiet origin/main >/dev/null 2>&1; then
	if node scripts/changeset-required.ts origin/main >"$LOG" 2>&1; then
		echo "ok"
	elif [ $? -eq 2 ]; then
		echo "skipped (nothing differs from origin/main)"
	else
		echo "FAILED"
		echo ""
		tail -20 "$LOG"
		echo ""
		echo "  A versioned package changed with no changeset. Run 'pnpm changeset'."
		echo "  Push aborted."
		exit 1
	fi
else
	echo "skipped (no origin/main ref)"
fi
